# Chép thành .env.docker trên máy sẽ chạy container; file thật không đưa lên GitHub.
SECRET_KEY=
# Compose chỉ mở cổng localhost bằng HTTP. Khi dùng HTTPS đặt true và sửa TRUSTED_HOSTS.
SESSION_COOKIE_SECURE=false
TRUSTED_HOSTS=localhost,127.0.0.1
AI_CHAT_ENABLED=true
AI_TUTOR_ENABLED=true
LLM_PROVIDER=openai
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Điền CHÍNH XÁC model đang chạy thành công trên máy bạn, không đổi theo ví dụ khác.
LLM_MODEL=
LLM_API_KEY=
LLM_REASONING_EFFORT=low
EMBED_PROVIDER=openai
EMBED_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBED_MODEL=gemini-embedding-001
# Nếu để trống, app dùng LLM_API_KEY cho embedding.
EMBED_API_KEY=
AI_HTTP_TIMEOUT=120
AI_TOP_K=6
AI_HYBRID_ALPHA=0.7
AI_MAX_CONTEXT_CHARS=4000
AI_MAX_OUTPUT_TOKENS=2048
AI_TUTOR_MAX_OUTPUT_TOKENS=4096
AI_TUTOR_MAX_CONTEXT_CHARS=120000
AI_TUTOR_MAX_ATTEMPTS=3
AI_DAILY_CALL_LIMIT=60
