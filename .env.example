# MẪU cho cài mới. Khi nâng cấp, giữ nguyên .env đang chạy của bạn.
# scripts/setup_local.py tạo SECRET_KEY ngẫu nhiên nếu chưa có cấu hình.
MEDQUEST_ENV=development
SECRET_KEY=
DEV_DATABASE_URL=sqlite:///medquest_dev.sqlite
# DB đã có ở thư mục khác: GIỮ đường dẫn DEV_DATABASE_URL đang dùng.
AI_CHAT_ENABLED=false
AI_TUTOR_ENABLED=false
LLM_PROVIDER=demo
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_REASONING_EFFORT=
EMBED_PROVIDER=local
EMBED_BASE_URL=
EMBED_MODEL=
EMBED_API_KEY=
AI_HTTP_TIMEOUT=120
AI_TOP_K=6
AI_HYBRID_ALPHA=0.7
AI_MAX_CONTEXT_CHARS=4000
AI_MAX_OUTPUT_TOKENS=2048
AI_TUTOR_MAX_OUTPUT_TOKENS=6144
AI_TUTOR_MAX_CONTEXT_CHARS=120000
AI_TUTOR_MAX_ATTEMPTS=3
AI_DAILY_CALL_LIMIT=60
# Khi đã cấu hình provider thật, bật AI_CHAT_ENABLED và AI_TUTOR_ENABLED.
# LLM_MODEL phải là tên model chạy thành công với tài khoản của bạn.
